  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend",
      "items": [
        "Vite serve a SPA em :3000 e gera dist/ para entrega estatica",
        "App.tsx compoe ThemeProvider, CookiesProvider, Redux, SchedulingProvider, BrowserRouter, Helmet e QueryClientProvider",
        "Router.tsx separa rotas publicas, auth e app"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dados",
      "items": [
        "RTK Query lista pacientes com page/size em patient/list",
        "Axios cobre auth/login, auth/me, auth/register e patient/save",
        "Scheduling usa estado local, date-fns e contexto para datas da semana"
      ]
    },
    {
      "dot": "rose",
      "title": "Sessao",
      "items": [
        "FirstScreen decide entre /sign-in e /agendamento lendo cookies.jwt",
        "Axios e fetchBaseQuery usam VITE_API_URL com credenciais incluidas",
        "storageProxy mantem utilitarios para AUTHORIZATION_KEY no localStorage"
      ]
    },
    {
      "dot": "amber",
      "title": "Desenvolvimento",
      "items": [
        "npm run dev inicia Vite; npm run dev:server inicia json-server data.json em :3333",
        "data.json contem fixtures de schedulings e patients",
        "Permissao patient:list ja aparece na configuracao de rota de pacientes"
      ]
    }
  ]

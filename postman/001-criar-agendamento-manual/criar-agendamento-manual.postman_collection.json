    },
    {
      "name": "03 - Permissões, snapshots e validações",
      "item": [
        {
          "name": "BB-15 - ADMIN sobrescreve duração",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\", \"unitId\": \"{{unitId}}\", \"serviceId\": \"{{serviceId}}\", \"professionalId\": null, \"startsAt\": \"{{overrideDurationSlot}}\", \"durationMinutes\": 75, \"price\": \"150.00\"\n}"
            },
            "url": "{{baseUrl}}{{schedulingPath}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('BB-15 preserva duração administrativa', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().durationMinutes).to.eql(75); });"
                ]
              }
            }
          ]
        },
        {
          "name": "BB-15 - ADMIN sobrescreve preço",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientBId}}\", \"unitId\": \"{{unitId}}\", \"serviceId\": \"{{serviceId}}\", \"professionalId\": null, \"startsAt\": \"{{overridePriceSlot}}\", \"durationMinutes\": 60, \"price\": \"175.50\"\n}"
            },
            "url": "{{baseUrl}}{{schedulingPath}}"
          },
          "event": [
            {
              "listen": "test",

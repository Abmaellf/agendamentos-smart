                  "const index = Number(pm.collectionVariables.get('invalidValueIndex') || 0);",
                  "const payload = Object.assign({ patientId: pm.environment.get('patientDId'), unitId: pm.environment.get('unitId'), serviceId: pm.environment.get('serviceId'), professionalId: null }, invalid[index]); pm.variables.set('invalidPayload', JSON.stringify(payload));"
                ]

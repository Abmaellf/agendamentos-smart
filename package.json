{
  "name": "agendamentos-smart",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "json-server data.json -p 3333 -w",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier  --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:postman:setup": "newman run postman/001-criar-agendamento-manual/criar-agendamento-manual.postman_collection.json -e postman/001-criar-agendamento-manual/local.postman_environment.json --env-var baseUrl=http://localhost:8082 --folder \"00 - Autenticação de teste\" --bail",
    "test:postman:smoke": "newman run postman/001-criar-agendamento-manual/backend-atual-smoke.postman_collection.json -e postman/001-criar-agendamento-manual/local.postman_environment.json --env-var baseUrl=http://localhost:8082 --bail",
    "test:postman": "newman run postman/001-criar-agendamento-manual/criar-agendamento-manual.postman_collection.json -e postman/001-criar-agendamento-manual/local.postman_environment.json --env-var baseUrl=http://localhost:8082 --bail",
    "test:postman:race": "newman run postman/001-criar-agendamento-manual/concorrencia-ultima-vaga.postman_collection.json -e postman/001-criar-agendamento-manual/local.postman_environment.json --env-var baseUrl=http://localhost:8082 --bail"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.85.3",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "eslint-plugin-react": "^7.37.5",
    "json-server": "^0.17.0",
    "lucide-react": "^0.523.0",
    "phosphor-react": "^1.4.1",
    "react": "^18.3.1",
    "react-cookie": "^8.0.1",
    "react-datepicker": "^8.3.0",
    "react-day-picker": "^9.7.0",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.58.1",
    "react-router-dom": "^7.5.2",
    "scheduler": "^0.26.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "use-context-selector": "^2.0.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.0.13",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.29.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "newman": "^6.2.2",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "tw-animate-css": "^1.3.5",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
